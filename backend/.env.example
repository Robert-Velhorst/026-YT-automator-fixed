APP_ENV=development
SECRET_KEY=replace-with-a-unique-random-value-at-least-32-characters
DATABASE_URL=sqlite:///automator.db
UPLOAD_FOLDER=uploads
GENERATED_FOLDER=generated
MAX_CONTENT_LENGTH=2147483648
GOOGLE_CLIENT_SECRETS_FILE=C:/absolute/path/to/google-oauth-client.json
TOKEN_ENCRYPTION_KEY=replace-with-a-valid-fernet-key
PUBLIC_BASE_URL=
FRONTEND_URL=http://127.0.0.1:5000
CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
LOCAL_AUTH_BYPASS=true
OPERATOR_PASSWORD_HASH=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1
FFMPEG_PATH=ffmpeg
WORKER_POLL_SECONDS=5
JOB_MAX_RETRIES=3
JOB_LEASE_SECONDS=300
JOB_VERIFY_SECONDS=30
STALE_WORKER_SECONDS=120
MAX_DASHBOARD_ITEMS=200
HAI_CONNECTOR_ENABLED=false
HAI_CONNECTOR_TOKEN=
PORT=5000
LOG_LEVEL=INFO
